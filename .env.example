# Radiology Education Platform Configuration
# Environment configuration file - DO NOT commit real secrets to source control.

# Telegram Bot & Core Settings
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567
DATABASE_URL=sqlite+aiosqlite:///./radiology.db
ADMIN_ID=123456789
SECRET_KEY=change_this_to_a_random_secret_key_in_production
REDIS_URL=redis://localhost:6379/0

# Telegram Proxy Configuration (Supports HTTP, HTTPS, SOCKS4, SOCKS5)
# Examples:
# TELEGRAM_PROXY_URL=http://127.0.0.1:10809
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10809
TELEGRAM_PROXY_URL=

# Web Admin Authentication Credentials (Required for Web Panel login)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Installation status
IS_INSTALLED=false
DEBUG=true
APP_ENV=development
